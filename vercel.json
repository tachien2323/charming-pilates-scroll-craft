{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/styleguide", "destination": "/styleguide.html" },
    { "source": "/chinh-sach-bao-mat", "destination": "/chinh-sach-bao-mat.html" },
    { "source": "/dieu-khoan", "destination": "/dieu-khoan.html" }
  ],
  "headers": [
    {
      "source": "/(brand|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
